# Copie para .env.local e preencha. Nunca versione .env.local.

# Supabase: Project Settings > API (use a chave "publishable", nunca a secret/service_role)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública do app (local: http://localhost:3000; produção: https://seu-dominio)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Apenas para o Supabase local (supabase start): credenciais do OAuth do Google
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
